{
  "DPN main": {
    "prefix": "main",
    "body": [
      "fn main() {",
      "    $0",
      "}"
    ],
    "description": "DPN entry point"
  },
  "DPN function": {
    "prefix": "fn",
    "body": [
      "fn ${1:name}(${2:args}) {",
      "    $0",
      "}"
    ],
    "description": "Function declaration"
  },
  "DPN loop": {
    "prefix": "while",
    "body": [
      "while ${1:condition} {",
      "    $0",
      "}"
    ],
    "description": "While loop"
  },
  "DPN typed function": {
    "prefix": "fn-typed",
    "body": [
      "fn ${1:name}(${2:value}: ${3:number}) -> ${4:number} {",
      "    return ${2:value};",
      "}"
    ],
    "description": "Typed DPN function with runtime contracts"
  },
  "DPN typed variable": {
    "prefix": "let-typed",
    "body": [
      "let ${1:name}: ${2:number} = ${3:0};"
    ],
    "description": "Runtime-checked DPN variable"
  }
}
